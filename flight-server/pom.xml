<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pro.surpin.arrowflight</groupId>
        <artifactId>arrow-flight-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>pro.surpin.arrowflight</groupId>
    <artifactId>arrow-flight-server</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Arrow Flight Server</name>
    <description>
        High-performance Arrow Flight SQL server for analytical queries on Parquet data stored in
        HDFS or Apache Ozone. Runs as a sidecar on each storage node to exploit data locality,
        uses DuckDB for in-process aggregation, and exposes a standard Flight SQL interface to
        Python, Java, Spark, Trino, and any compliant client.
    </description>
    <url>https://github.com/VadimSurpin/arrow-flight-server</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>VadimSurpin</id>
            <name>Vadim Surpin</name>
            <email>vadim.surpin@gmail.com</email>
            <url>https://github.com/VadimSurpin</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/VadimSurpin/arrow-flight-server.git</connection>
        <developerConnection>scm:git:git@github.com:VadimSurpin/arrow-flight-server.git</developerConnection>
        <url>https://github.com/VadimSurpin/arrow-flight-server</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/VadimSurpin/arrow-flight-server/issues</url>
    </issueManagement>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Override with -DexcludedGroups="" to include integration/spark/smoke tests -->
        <excludedGroups>integration,spark,perf,smoke,real-services,s3</excludedGroups>
        <hadoop.version>3.5.0</hadoop.version>
        <arrow.version>19.0.0</arrow.version>
        <guava.version>32.1.3-jre</guava.version>
        <jooq.version>3.21.6</jooq.version>
        <!-- Pinned to 1.4.5: the hadoopfs (docker/scripts/build_duckdb_hdfs.sh) and httpfs extension
             files are built for exactly DuckDB v1.4.5, other versions refuse to load them. Bump together.
             1.4.1-1.4.3 have the hash-aggregate bug behind the q04 wrong answer (fixed in 1.4.4). -->
        <duckdb.version>1.4.5.0</duckdb.version>
        <iceberg.it.extensionDir></iceberg.it.extensionDir>
        <spark.version>3.5.9</spark.version>
        <grpc.version>1.84.2</grpc.version>
        <netty.version>4.2.19.Final</netty.version>
        <junit.version>5.14.4</junit.version>
        <jackson.version>2.21.8</jackson.version>
        <hazelcast.version>5.7.0</hazelcast.version>
        <!-- 1.15+ brings aircompressor 2.0.3 and snappy-java 1.1.10.x (crafted-input advisories in
             0.21 / 1.1.8.3, docs/dev/DEPENDENCY-AUDIT.md); DependencyFloorTest guards the floor. -->
        <parquet.version>1.18.1</parquet.version>
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <!-- SonarCloud -->
        <sonar.projectKey>VadimSurpin_arrow-flight-server</sonar.projectKey>
        <sonar.organization>VadimSurpin</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- One Netty version for every module (Arrow, gRPC, Hadoop bring older ones). -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- One Jackson version (databind, core, YAML, jsr310 and the Scala module of the Spark
                 test dependencies), on the line Arrow 19 brings (2.21). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Keep the httpcore 4.4.13 that Hadoop and target/libs already use. -->
            <!-- Hadoop 3.5.0 brings bcprov 1.82; bcpkix/bcutil are 1.85: keep the three in step. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpcore</artifactId>
                <version>4.4.13</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Plugin SPI: shaded into the server jar; plugins declare it provided. -->
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test plugin for the plugin loader tests: only orders the reactor (built first); its
             jars are read from ../flight-plugin-fixture/target, never put on the classpath. -->
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-plugin-fixture</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.11.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Hazelcast -->
        <dependency>
            <groupId>com.hazelcast</groupId>
            <artifactId>hazelcast</artifactId>
            <version>${hazelcast.version}</version>
        </dependency>

        <!-- Hadoop Core -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
            <!-- The MapReduce client's netty-all: see hadoop-hdfs below. -->
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Hadoop HDFS -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
            <!-- Its netty-all would put every Netty codec back on the test classpath. -->
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- S3 is the s3 plugin (flight-plugin-s3, plugins/s3): no AWS SDK in this jar. Its test
             jar (FakeS3, TestTls) serves the tests that load the plugin from its target/plugin/s3,
             which also orders the reactor; nothing of it reaches the main classpath. -->
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-plugin-s3</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The iceberg plugin (flight-plugin-iceberg, plugins/iceberg): the catalog tests load it from
             its target/plugin/iceberg and write their tables with its test classes over its
             target/fixture-libs; this test-jar dependency only orders the reactor. -->
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-plugin-iceberg</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The hive plugin (flight-plugin-hive, plugins/hive): the catalog tests load it from its
             target/plugin/hive and run its in-process metastore over its target/fixture-libs;
             this test-jar dependency only orders the reactor. -->
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-plugin-hive</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Embedded Apache Ranger policy evaluator. Hadoop comes from this deployment. -->
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-plugins-common</artifactId>
            <version>2.8.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-client-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-client-runtime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Arrow Flight SQL (включает в себя arrow-flight функциональность) -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>flight-sql</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>flight-core</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <!-- Arrow Vector (для Parquet чтения) -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <!-- Required by DuckDB JDBC arrowExportStream. -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-c-data</artifactId>
            <version>${arrow.version}</version>
        </dependency>

        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>${duckdb.version}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.5</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- Only the Netty modules the gRPC server uses (netty-all carried every codec, with their
             advisories): HTTP/2, proxy support and the Linux epoll transport. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler-proxy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-aarch_64</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Parquet -->
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-hadoop</artifactId>
            <version>${parquet.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-common</artifactId>
            <version>${parquet.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-column</artifactId>
            <version>${parquet.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.20</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <!-- jOOQ Parser (встроен в основной артефакт jooq) -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
            <version>${jooq.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.34.1</version>
        </dependency>

        <!-- Apache Spark -->
        <!-- Core Spark functions -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_2.12</artifactId>
            <version>${spark.version}</version>
            <scope>test</scope>
            <!-- netty-bom manages native modules to runtime scope, which would ship Spark's macOS
                 kqueue transport in the server jar. -->
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-kqueue</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- For Spark SQL and DataFrames -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_2.12</artifactId>
            <version>${spark.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Dagger 2 compile-time DI -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
            <version>2.50</version>
        </dependency>

        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
        </dependency>

        <!-- JUnit для тестов -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.20.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>**/debug/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <!-- s3:// data directories in tests load the real s3 plugin, built before this module -->
                        <arrowflight.plugins.dir>${project.basedir}/../flight-plugin-s3/target/plugin</arrowflight.plugins.dir>
                        <!-- Iceberg catalog tests: DuckDB's iceberg/avro extensions (v1.4.5/<platform>/
                             below this directory); without it those tests are skipped. -->
                        <iceberg.it.extensionDir>${iceberg.it.extensionDir}</iceberg.it.extensionDir>
                    </systemPropertyVariables>
                    <argLine>
                        @{argLine}
                        -ea
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
                        --add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <fork>true</fork>
                    <meminitial>1024m</meminitial>
                    <maxmem>2048m</maxmem>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.dagger</groupId>
                            <artifactId>dagger-compiler</artifactId>
                            <version>2.50</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>pro.surpin.data.arrowflight.server.HadoopArrowFlightServer</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <phase>test-compile</phase>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>

                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.26.1</version>
                    </dependency>
                </dependencies>

                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <failOnViolation>${checkstyle.failOnViolation}</failOnViolation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                    </sourceDirectories>
                    <violationSeverity>warning</violationSeverity>
                </configuration>

            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.3.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.18.0</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Server jar for Linux on x86-64 and ARM64 only (-Plinux-only): leaves out the DuckDB,
             zstd-jni and netty-tcnative native libraries of other platforms. -->
        <profile>
            <id>linux-only</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>shade</id>
                                <configuration>
                                    <artifactSet>
                                        <excludes combine.children="append">
                                            <exclude>io.netty:netty-tcnative-boringssl-static:jar:osx-x86_64</exclude>
                                            <exclude>io.netty:netty-tcnative-boringssl-static:jar:osx-aarch_64</exclude>
                                            <exclude>io.netty:netty-tcnative-boringssl-static:jar:windows-x86_64</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <filters combine.children="append">
                                        <filter>
                                            <artifact>org.duckdb:duckdb_jdbc</artifact>
                                            <excludes>
                                                <exclude>libduckdb_java.so_osx_*</exclude>
                                                <exclude>libduckdb_java.so_windows_*</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>net.java.dev.jna:jna</artifact>
                                            <excludes>
                                                <exclude>com/sun/jna/aix-*/**</exclude>
                                                <exclude>com/sun/jna/darwin*/**</exclude>
                                                <exclude>com/sun/jna/freebsd-*/**</exclude>
                                                <exclude>com/sun/jna/openbsd-*/**</exclude>
                                                <exclude>com/sun/jna/sunos-*/**</exclude>
                                                <exclude>com/sun/jna/win32-*/**</exclude>
                                                <exclude>com/sun/jna/linux-arm/**</exclude>
                                                <exclude>com/sun/jna/linux-armel/**</exclude>
                                                <exclude>com/sun/jna/linux-mips64el/**</exclude>
                                                <exclude>com/sun/jna/linux-ppc*/**</exclude>
                                                <exclude>com/sun/jna/linux-s390x/**</exclude>
                                                <exclude>com/sun/jna/linux-x86/**</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>com.github.luben:zstd-jni</artifact>
                                            <excludes>
