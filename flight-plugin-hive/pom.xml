    <artifactId>arrow-flight-plugin-hive</artifactId>
    <packaging>jar</packaging>
    <name>Arrow Flight Server Hive plugin</name>
    <description>
        Hive Metastore tables for the Arrow Flight SQL server as a table catalog (catalog=hive):
        databases are schemas, Parquet tables are tables, partitions come from the metastore and
        their files from the server's stores. Iceberg tables registered in the metastore go to the
        iceberg plugin's table format when that plugin is installed. The metastore is read with the
        Thrift client of Hive 3.1.3 on libthrift 0.24, without Hadoop.
        Installed as plugins/hive/ (target/plugin/hive): this jar, its runtime libraries and
        SHA256SUMS (tools/make-plugin-dir.sh). Not shaded: the plugin class loader isolates it.
    </description>

    <properties>
        <hive.version>3.1.3</hive.version>
        <thrift.version>0.24.0</thrift.version>
        <!-- fb303 has no release after 0.9.3; its generated code runs on the newer libthrift. -->
        <fb303.version>0.9.3</fb303.version>
        <!-- The in-process test metastore (Hive 3.1.3 server) only, in its own class loader. -->
        <fixture.thrift.version>0.9.3</fixture.thrift.version>
        <!-- Same as flight-server. -->
        <hadoop.version>3.5.0</hadoop.version>
        <duckdb.version>1.5.6.0</duckdb.version>
        <orc.version>2.1.3</orc.version>
        <storage-api.version>2.8.1</storage-api.version>
    </properties>

